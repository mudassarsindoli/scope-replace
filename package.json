{
  "name": "ScopeReplace",
  "displayName": "ScopeReplace",
  "description": "Global find-and-replace across manually selected files.",
  "version": "0.0.1",
  "publisher": "mudassarsindoli",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/placeholder-repository.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "find",
    "replace",
    "bulk",
    "search"
  ],
  "activationEvents": [
    "onCommand:ScopeReplace.findAndReplace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ScopeReplace.findAndReplace",
        "title": "ScopeReplace: Find & Replace",
        "category": "ScopeReplace"
      }
    ],
    "keybindings": [
      {
        "command": "ScopeReplace.findAndReplace",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}